# Bindings for the Cloudflare Pages project (Settings → Variables and Secrets). Nothing here is
# read by the Astro build; it is documentation of what functions/api/contact.js looks for.
CONTACT_FORWARD_URL=        # a lead intake endpoint (Front Desk web source), optional
CONTACT_FORWARD_SECRET=     # bearer token for it, optional
RESEND_API_KEY=             # Resend API key; the email fallback for the form
CONTACT_TO=support@steadfastcode.tech
CONTACT_FROM=Steadfast Code website <site@steadfastcode.tech>
