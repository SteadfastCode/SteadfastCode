# Cloudflare Pages response headers. Files under /_astro/ carry a content hash in their name, so a
# changed file is a new URL: they can be cached for a year. Everything else keeps Pages' default
# (revalidate every time), so a new deploy shows up immediately.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# The admin intake and client page load these by a versioned address (?v=<build>), and they also
# revalidate every time, so a deploy never leaves a page running yesterday's form script
# (2026-11-01: a cached project.js showed [object Object] in every dropdown).
/intake/*
  Cache-Control: no-cache
