---
// The admin intake (2026-11-01): Daniel fills this in with a client, on his phone, during the
// meeting. Cloudflare Access gates /admin and /api/admin; the API checks the signature again. The
// questions come from src/data/intake.ts and the packages from site.ts, both embedded below as JSON,
// so the page and the server (server/intake.js) can't disagree. Not a public page: noindex, out of
// the sitemap, and excluded from the public-page tests (test/admin.test.js covers it instead).
import { intakeSections, defaultPages } from '../data/intake';
import { websiteTiers, addOns } from '../data/site';

const config = {
  sections: intakeSections,
  defaultPages,
  tiers: websiteTiers.map((t) => ({ id: t.id, name: t.name, price: t.price, from: !!('from' in t && t.from), scope: t.scope, who: t.who })),
  editorPrice: addOns.find((a) => a.id === 'editor')?.price ?? null,
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Client intake — Steadfast Code admin</title>
<link rel="stylesheet" href="/intake/form.css">
</head>
<body>
<div id="progress" role="button" tabindex="0" aria-expanded="true" hidden></div>
<main id="app"><p class="muted">Loading…</p></main>
<footer class="bar" id="bar" hidden><div class="in"><span id="saved" class="muted"></span><span id="readiness" class="muted"></span><button class="primary" id="build" disabled>Start build</button></div></footer>
<script type="application/json" id="intake-config" set:html={JSON.stringify(config)}></script>
<script type="module" is:inline>
import { mountProject, wireProgress } from '/intake/project.js';

const C = JSON.parse(document.getElementById('intake-config').textContent);
const app = document.getElementById('app');
const bar = document.getElementById('bar');
const progress = document.getElementById('progress');
const esc = (s) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c]);
const money = (n, from) => (from ? 'from ' : '') + '$' + Number(n).toLocaleString('en-US');
const tierOf = (id) => C.tiers.find((t) => t.id === id);
const statusLabel = { intake: 'Intake', 'build-requested': 'Build requested', building: 'Building', preview: 'Preview ready', live: 'Live', closed: 'Closed' };
const api = async (path, init = {}) => {
  const r = await fetch('/api/admin' + path, { credentials: 'same-origin', headers: { 'content-type': 'application/json' }, ...init });
  const j = await r.json().catch(() => ({}));
  if (!r.ok) throw new Error(j.error || 'HTTP ' + r.status);
  return j;
};
wireProgress(progress);

// ---- Home: start from a package or a lead, or open a project ----
async function home() {
  bar.hidden = true;
  progress.hidden = true;
  app.innerHTML = '<h1>Client intake</h1><p class="muted">Loading…</p>';
  let leads = [], projects = [], err = '';
  try { [{ leads }, { projects }] = await Promise.all([api('/leads'), api('/projects')]); } catch (e) { err = e.message; }
  app.innerHTML = `
    <h1>Client intake</h1>
    ${err ? `<p class="error">${esc(err)}</p>` : ''}
    <section class="card"><h2>New project</h2><div class="tiers">
      ${C.tiers.map((t) => `<button data-new="${t.id}"><b>${esc(t.name)}</b><span>${money(t.price, t.from)} · ${t.scope.pages} page${t.scope.pages === 1 ? '' : 's'}</span></button>`).join('')}
      <button data-new=""><b>Not sure yet</b><span>Pick the package as you talk</span></button>
    </div></section>
    <section class="card"><h2>From a contact form</h2>
      ${leads.length ? leads.map((l) => `<div class="row"><div><b>${esc(l.name)}</b>${l.business ? ' · ' + esc(l.business) : ''}<div class="muted">${esc(tierOf(l.plan)?.name || l.plan || 'no package picked')} · ${esc(new Date(l.received_at).toLocaleDateString())}</div></div><button data-lead="${esc(l.id)}">Start from this</button></div>`).join('') : '<p class="muted">No new contact-form leads.</p>'}
    </section>
    <section class="card"><h2>Projects</h2>
      ${projects.length ? projects.map((p) => `<div class="row"><div><a href="#p/${esc(p.id)}"><b>${esc(p.business || 'Untitled')}</b></a><div class="muted">${esc(tierOf(p.tier)?.name || 'no package')} · ${esc(new Date(p.updatedAt).toLocaleString())}</div></div><span class="badge${p.ready ? ' ready' : ''}">${esc(statusLabel[p.status] || p.status)}${p.status === 'intake' && p.ready ? ' · ready' : ''}</span></div>`).join('') : '<p class="muted">None yet.</p>'}
    </section>`;
  app.querySelectorAll('[data-new]').forEach((b) => b.addEventListener('click', () => create({ tier: b.dataset.new || undefined })));
  app.querySelectorAll('[data-lead]').forEach((b) => b.addEventListener('click', () => create({ leadId: b.dataset.lead })));
}

async function create(body) {
  try { const p = await api('/projects', { method: 'POST', body: JSON.stringify(body) }); location.hash = 'p/' + p.id; }
  catch (e) { alert('Could not start the project: ' + e.message); }
}

// ---- A project: the shared form (public/intake/project.js), Daniel's side ----
let current = null;
async function route() {
  if (current) { current.stop(); current = null; }
  const m = location.hash.match(/^#p\/([\w-]+)$/);
  if (!m) return home();
  const base = '/api/admin/projects/' + encodeURIComponent(m[1]);
  current = await mountProject({
    root: app, bar, progress, config: C, mode: 'admin', backHref: '#',
    routes: { project: base, presence: base + '/presence', uploads: base + '/uploads', file: (id) => base + '/uploads/' + encodeURIComponent(id), build: base + '/build', link: base + '/link' },
  });
}
addEventListener('hashchange', route);
route();
</script>
</body>
</html>
