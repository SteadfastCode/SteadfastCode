---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found — Steadfast Code" description="That page is not here. The home page, prices and contact form are." crumb="Not found">
  <section class="block">
    <div class="wrap prose">
      <h1>That page isn't here.</h1>
      <p class="answer">Maybe an old link, maybe a typo. Either way, the useful pages are a click away.</p>
      <div class="cta-row">
        <a class="btn" href="/">Home</a>
        <a class="btn ghost" href="/websites">Prices</a>
        <a class="btn ghost" href="/contact">Contact</a>
      </div>
    </div>
  </section>
</Base>
