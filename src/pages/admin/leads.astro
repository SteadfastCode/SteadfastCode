---
// /admin/leads (2026-11-03): the outreach board. Who to reach, who has been reached, what they
// said, what is next; and from any lead that isn't a partner, Start a project, which opens the
// intake at /admin with what the board knows filled in. Behind the same Cloudflare Access app as
// /admin; the API under /api/admin/leads checks the signature again. The statuses, kinds and
// touch kinds are embedded from server/leads.js, so the page and the server can't disagree.
import { websiteTiers } from '../../data/site';
import { STATUSES, STATUS_LABEL, ACTIVE, KINDS, KIND_LABEL, SITE_STATES, SITE_STATE_LABEL, TOUCH_KINDS, TOUCH_LABEL } from '../../../server/leads.js';

const v = Date.now().toString(36);
const config = {
  tiers: websiteTiers.map((t) => ({ id: t.id, name: t.name })),
  statuses: STATUSES, statusLabel: STATUS_LABEL, active: ACTIVE,
  kinds: KINDS, kindLabel: KIND_LABEL,
  siteStates: SITE_STATES, siteStateLabel: SITE_STATE_LABEL,
  touchKinds: TOUCH_KINDS.filter((k) => !['status', 'project'].includes(k)), touchLabel: TOUCH_LABEL,
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Leads — Steadfast Code admin</title>
<link rel="stylesheet" href={`/intake/form.css?v=${v}`}>
<style is:global>
  /* The board uses the width: on a wide screen the last touch gets the room, clamped to three lines. */
  main { max-width: 1440px; }
  .admin-head .in { max-width: 1440px; }
  .toolbar { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin: 0 0 12px; }
  .toolbar .spacer { flex: 1; }
  .filters { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 0 6px; }
  .filters button { padding: 6px 10px; font-size: .9rem; }
  .filters button[aria-pressed="true"] { border-color: var(--accent); box-shadow: 0 0 0 2px var(--accent) inset; }
  .filters input[type=search] { flex: 1 1 160px; font: inherit; padding: 6px 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--ink); min-width: 120px; }
  .lead { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1.5fr) 9.5rem minmax(0, 3.2fr) minmax(0, 1.2fr); gap: 10px; padding: 10px 0; border-top: 1px solid var(--line); align-items: start; }
  .lead:first-of-type { border-top: 0; }
  .lead .sub { color: var(--muted); font-size: .85rem; overflow-wrap: anywhere; }
  .lead .touch .sub { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3; line-clamp: 3; overflow: hidden; }
  .lead select { width: auto; max-width: 100%; padding: 6px 8px; font-size: .9rem; }
  .lead select.s-won { border-color: var(--ok); }
  .lead select.s-lost, .lead select.s-hold { opacity: .7; }
  .lead .head { display: block; font-size: .78rem; color: var(--muted); text-transform: uppercase; letter-spacing: .04em; }
  @media (min-width: 761px) { .lead .head { display: none; } .lead.cols { font-size: .85rem; color: var(--muted); font-weight: 600; padding: 4px 0; } }
  @media (max-width: 760px) { .lead { grid-template-columns: 1fr 1fr; } .lead .main, .lead .touch { grid-column: 1 / -1; } .lead.cols { display: none; } }
  .due-overdue { color: var(--bad); font-weight: 600; } .due-today { color: var(--warn); font-weight: 600; } .due-soon { color: var(--warn); }
  ul.next { list-style: none; padding: 0; margin: 0; }
  ul.next li { display: flex; flex-wrap: wrap; gap: 4px 12px; align-items: baseline; padding: 6px 0; border-top: 1px solid var(--line); }
  ul.next li:first-child { border-top: 0; }
  .fields { display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 0 14px; }
  .fields .wide { grid-column: 1 / -1; }
  .fields input[type=date], .fields input[type=url] { width: 100%; font: inherit; padding: 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--ink); }
  .btns { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 12px; }
  button.danger { color: var(--bad); }
  form.touch { display: grid; grid-template-columns: 1fr 2fr; gap: 0 14px; }
  form.touch .wide { grid-column: 1 / -1; }
  form.touch input[type=date] { width: 100%; font: inherit; padding: 10px; border: 1px solid var(--line); border-radius: 8px; background: var(--bg); color: var(--ink); }
  ul.log { list-style: none; padding: 0; margin: 14px 0 0; display: grid; gap: 8px; }
  ul.log li { border-top: 1px solid var(--line); padding-top: 8px; overflow-wrap: anywhere; }
  ul.log .when { color: var(--muted); font-size: .85rem; }
  .badge.kind { text-transform: none; }
  .badge.mock { text-transform: none; color: var(--accent); border-color: var(--accent); text-decoration: none; }
  .badge.mock:hover { background: var(--accent); color: var(--accent-ink, #fff); }
  .mockrow { display: flex; flex-wrap: wrap; align-items: center; gap: .6rem 1rem; }
  .mockrow .help { flex: 1 1 24rem; }
  pre.result { white-space: pre-wrap; font: inherit; font-size: .9rem; background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: 10px; }
  textarea.paste { min-height: 160px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: .85rem; }
  h1 .badge { vertical-align: middle; font-size: .85rem; }
</style>
<script src={`/admin/app.js?v=${v}`} defer></script>
</head>
<body>
<header class="admin-head stick"><div class="in"><span class="mark">Steadfast Code <span class="muted">admin</span></span><nav aria-label="Admin"><a href="/admin">Intake</a><a href="/admin/leads" aria-current="page">Leads</a><a href="/admin/inbox">Inbox</a><a href="/admin/care">Care plans</a><a href="/admin/usage">Usage</a></nav></div></header>
<main id="app"><p class="muted">Loading…</p></main>
<script type="application/json" id="leads-config" set:html={JSON.stringify(config)}></script>
<script>
  // The leads board, written to be read; Astro bundles and minifies it for the build. One page with
  // four views, picked by the hash — the board (no hash), one lead (#l/<id>), add (#new) and import
  // (#import). Each view renders its HTML into <main id="app"> and then wires up its controls.
  //
  // The statuses, kinds, site states, touch kinds and packages come from the JSON above, which the
  // page built from server/leads.js, so nothing here keeps a second copy of them.

  /** [value, label]: one <option>, or one filter chip. */
  type Choice = [value: string, label: string];

  type Config = {
    tiers: { id: string; name: string }[];
    statuses: string[];
    statusLabel: Record<string, string>;
    active: string[];
    kinds: string[];
    kindLabel: Record<string, string>;
    siteStates: string[];
    siteStateLabel: Record<string, string>;
    touchKinds: string[];
    touchLabel: Record<string, string>;
  };

  /** How close a lead's next step is, or null when there is nothing to chase. */
  type Due = 'overdue' | 'today' | 'soon' | null;

  type Touch = { kind: string; at: string; text: string; status?: string; who?: string };
  type Project = { id: string; status: string; business?: string; previewUrl?: string };

  /** A lead as /api/admin/leads sends it, plus `due`, which this page works out for itself. */
  type Lead = {
    id: string;
    business: string;
    contact: string;
    role: string;
    email: string;
    phone: string;
    website: string;
    town: string;
    category: string;
    kind: string;
    siteState: string;
    fit: string;
    status: string;
    nextStep: string;
    nextAt: string;
    source: string;
    why: string;
    message: string;
    mockUrl: string;
    updatedAt: string;
    lastTouch: Touch | null;
    projects: Project[];
    due: Due;
  };

  const config: Config = JSON.parse(document.getElementById('leads-config')!.textContent!);
  const app = document.getElementById('app')!;

  // ---- the small jobs every view needs ----

  const HTML_ESCAPES: Record<string, string> = {
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  };

  /** Everything written into the page goes through here: a lead's own words are not markup. */
  function escapeHtml(value: unknown): string {
    return String(value ?? '').replace(/[&<>"']/g, (character) => HTML_ESCAPES[character]);
  }

  /** One call to the admin API. Throws with the server's own message, which the views show. */
  async function callApi(path: string, init: RequestInit = {}): Promise<any> {
    const response = await fetch('/api/admin' + path, {
      credentials: 'same-origin',
      headers: { 'content-type': 'application/json' },
      ...init,
    });
    const body = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(body.error || 'HTTP ' + response.status);
    return body;
  }

  /** What to tell the reader when a call failed. */
  function reasonFor(error: unknown): string {
    return error instanceof Error ? error.message : String(error);
  }

  /** How long ago something was logged, in the roughest unit that still says something. */
  function timeAgo(iso: string): string {
    const minutes = Math.round((Date.now() - new Date(iso).getTime()) / 60000);
    if (!isFinite(minutes)) return '';
    if (minutes < 1) return 'just now';
    if (minutes < 60) return `${minutes} min ago`;
    if (minutes < 1440) return `${Math.round(minutes / 60)} h ago`;
    return `${Math.round(minutes / 1440)} d ago`;
  }

  const tierName = (id: string) => config.tiers.find((tier) => tier.id === id)?.name || '';

  /** Live means still being worked: not won, lost or on hold. */
  const isLive = (lead: Lead) => config.active.includes(lead.status);

  // Dates on the board are days Daniel typed, read against his own calendar, not UTC.
  function localDay(date: Date): string {
    const local = new Date(date.getTime() - date.getTimezoneOffset() * 60000);
    return local.toISOString().slice(0, 10);
  }

  const today = localDay(new Date());
  const inAWeek = localDay(new Date(Date.now() + 7 * 86400_000));

  /** A date only counts as due while the lead is live or on hold; on a won lead it is history. */
  function dueState(lead: Lead): Due {
    const chasing = isLive(lead) || lead.status === 'hold';
    if (!lead.nextAt || !chasing) return null;
    if (lead.nextAt < today) return 'overdue';
    if (lead.nextAt === today) return 'today';
    if (lead.nextAt <= inAWeek) return 'soon';
    return null;
  }

  const DUE_RANK: Record<string, number> = { overdue: 0, today: 1, soon: 2 };

  /** The board's order: what is due first, then by status, with won, lost and hold at the end. */
  function boardRank(lead: Lead): number {
    const byDue = (DUE_RANK[lead.due ?? ''] ?? 3) * 100;
    const byStatus = config.statuses.indexOf(lead.status) + (isLive(lead) ? 0 : 10);
    return byDue + byStatus;
  }

  /** Same rank: whichever was touched most recently goes first. */
  function byBoardOrder(a: Lead, b: Lead): number {
    return boardRank(a) - boardRank(b) || (b.updatedAt || '').localeCompare(a.updatedAt || '');
  }

  // ---- websites, links and badges ----

  // A lead's website becomes a link only when it really is a web address: the contact form takes
  // any text for "current site", and this page runs as Daniel, so anything else stays plain text.
  function webAddress(url: string): { shown: string; href: string | null } {
    const shown = escapeHtml(url.replace(/^https?:\/\//i, '').replace(/\/$/, ''));
    try {
      const parsed = new URL(/^https?:\/\//i.test(url) ? url : `https://${url}`);
      if (!/^https?:$/.test(parsed.protocol) || !parsed.hostname.includes('.')) return { shown, href: null };
      return { shown, href: escapeHtml(parsed.href) };
    } catch {
      return { shown, href: null };
    }
  }

  function asLink(url: string): string {
    const { shown, href } = webAddress(url);
    if (!href) return shown;
    return `<a href="${href}" target="_blank" rel="noopener">${shown}</a>`;
  }

  /** A prospect is the usual kind, so only the other two wear a badge. */
  function kindBadge(lead: Lead): string {
    if (lead.kind === 'prospect') return '';
    return ` <span class="badge kind">${escapeHtml(config.kindLabel[lead.kind])}</span>`;
  }

  /** A mock-up built for the lead opens in a new tab straight from the board (a phone in a meeting). */
  function mockBadge(lead: Lead): string {
    if (!lead.mockUrl) return '';
    const { shown, href } = webAddress(lead.mockUrl);
    if (!href) return ` ${shown}`;
    return ` <a class="badge mock" href="${href}" target="_blank" rel="noopener">Mock-up</a>`;
  }

  /** The line under a lead's name: where they are, what they do, their site today, the package. */
  function summaryLine(lead: Lead): string {
    return [
      escapeHtml(lead.town),
      escapeHtml(lead.category),
      lead.website ? asLink(lead.website) : '',
      lead.siteState !== 'unknown' ? escapeHtml(config.siteStateLabel[lead.siteState]) : '',
      lead.fit ? escapeHtml(tierName(lead.fit)) : '',
    ].filter(Boolean).join(' · ');
  }

  /** The status list, used on every board row and in the log form. */
  function statusOptionsHtml(selected: string): string {
    return config.statuses
      .map((status) => {
        const chosen = status === selected ? ' selected' : '';
        return `<option value="${status}"${chosen}>${escapeHtml(config.statusLabel[status])}</option>`;
      })
      .join('');
  }

  /** The note next to a button: "Saving…", or why it did not save. */
  function setNote(id: string, text: string, bad = false) {
    const note = document.getElementById(id);
    if (!note) return;
    note.textContent = text;
    note.classList.toggle('error', bad);
  }

  /** Every named control in a form, as the API's own field names. */
  function formValues(form: HTMLFormElement): Record<string, string> {
    const controls = [...form.elements] as (HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement)[];
    return Object.fromEntries(controls.filter((control) => control.name).map((control) => [control.name, control.value]));
  }

  // ---- the lead's fields, written once for both the Add and the Details forms ----

  type Field = {
    id: string;
    label: string;
    options?: Choice[];
    type?: string;
    max?: number;
    placeholder?: string;
    wide?: boolean;
    required?: boolean;
  };

  const FIELDS: Field[] = [
    { id: 'business', label: 'Business, church or organization', required: true, wide: true, max: 160 },
    { id: 'kind', label: 'Kind', options: config.kinds.map((kind) => [kind, config.kindLabel[kind]]) },
    { id: 'category', label: 'Category', placeholder: 'plumber, church, chamber…', max: 60 },
    { id: 'town', label: 'Town', max: 80 },
    { id: 'website', label: 'Website', placeholder: 'example.com, or blank', max: 300 },
    { id: 'siteState', label: 'Their site today', options: config.siteStates.map((s) => [s, config.siteStateLabel[s]]) },
    {
      id: 'mockUrl',
      label: 'Mock-up preview (a Pages link, if you built one)',
      placeholder: 'https://stdfst-….pages.dev',
      wide: true,
      max: 300,
    },
    { id: 'contact', label: 'Contact', max: 120 },
    { id: 'role', label: 'Role', max: 80 },
    { id: 'email', label: 'Email', type: 'email', max: 200 },
    { id: 'phone', label: 'Phone', type: 'tel', max: 40 },
    { id: 'fit', label: 'Likely package', options: [['', 'Not sure yet'], ...config.tiers.map((t): Choice => [t.id, t.name])] },
    { id: 'status', label: 'Status', options: config.statuses.map((s) => [s, config.statusLabel[s]]) },
    { id: 'nextStep', label: 'Next step', max: 300 },
    { id: 'nextAt', label: 'By', type: 'date' },
    { id: 'source', label: 'Where this lead came from', placeholder: 'a directory, a referral, the research…', wide: true, max: 300 },
    { id: 'why', label: 'Why reach out', type: 'textarea', wide: true, max: 1500 },
  ];

  function fieldControlHtml(field: Field, value: string): string {
    const id = 'f-' + field.id;
    if (field.options) {
      const options = field.options
        .map(([option, label]) => {
          const chosen = option === value ? ' selected' : '';
          return `<option value="${escapeHtml(option)}"${chosen}>${escapeHtml(label)}</option>`;
        })
        .join('');
      return `<select id="${id}" name="${field.id}">${options}</select>`;
    }
    if (field.type === 'textarea') {
      return `<textarea id="${id}" name="${field.id}" maxlength="${field.max}">${escapeHtml(value)}</textarea>`;
    }
    const extras = [
      field.max ? ` maxlength="${field.max}"` : '',
      field.placeholder ? ` placeholder="${escapeHtml(field.placeholder)}"` : '',
      field.required ? ' required' : '',
    ].join('');
    return `<input id="${id}" name="${field.id}" type="${field.type || 'text'}" value="${escapeHtml(value)}"${extras}>`;
  }

  function fieldsHtml(values: Record<string, unknown> = {}): string {
    return FIELDS
      .map((field) => {
        const value = String(values[field.id] ?? '');
        const wide = field.wide ? ' class="wide"' : '';
        const star = field.required ? ' *' : '';
        const label = `<label for="f-${field.id}">${escapeHtml(field.label)}${star}</label>`;
        return `<div${wide}>${label}${fieldControlHtml(field, value)}</div>`;
      })
      .join('');
  }

  // ---- the board ----

  async function showBoard() {
    app.innerHTML = '<h1>Leads</h1><p class="muted">Loading…</p>';
    const { leads: loaded, seedAvailable } = await callApi('/leads');
    const leads: Lead[] = loaded.map((lead: Lead) => ({ ...lead, due: dueState(lead) })).sort(byBoardOrder);
    app.innerHTML = boardHtml(leads, seedAvailable);
    wireFilters();
    wireStatusSelects();
  }

  /** One lead as a row. data-* is what the filters and the search box match against. */
  function boardRowHtml(lead: Lead): string {
    const searchable = [
      lead.business, lead.town, lead.category, lead.contact, lead.email, lead.phone,
      lead.why, lead.source, lead.nextStep, config.statusLabel[lead.status],
      config.kindLabel[lead.kind], lead.mockUrl ? 'mock-up' : '',
    ].join(' ').toLowerCase();
    const data = [
      `data-id="${escapeHtml(lead.id)}"`,
      `data-status="${escapeHtml(lead.status)}"`,
      `data-kind="${escapeHtml(lead.kind)}"`,
      `data-mock="${lead.mockUrl ? 1 : 0}"`,
      `data-search="${escapeHtml(searchable)}"`,
    ].join(' ');
    return `<div class="lead" ${data}>
    ${boardNameCellHtml(lead)}
    ${boardContactCellHtml(lead)}
    ${boardStatusCellHtml(lead)}
    ${boardTouchCellHtml(lead)}
    ${boardNextCellHtml(lead)}
  </div>`;
  }

  function boardNameCellHtml(lead: Lead): string {
    const name = escapeHtml(lead.business || lead.contact || 'Untitled');
    const title = `<a href="#l/${escapeHtml(lead.id)}"><b>${name}</b></a>${kindBadge(lead)}${mockBadge(lead)}`;
    return `<div class="main">${title}<div class="sub">${summaryLine(lead)}</div></div>`;
  }

  function boardContactCellHtml(lead: Lead): string {
    const who = escapeHtml(lead.contact) || '<span class="muted">—</span>';
    const role = lead.role ? ` <span class="muted">${escapeHtml(lead.role)}</span>` : '';
    const reach = [
      lead.phone ? `<a href="tel:${escapeHtml(lead.phone.replace(/[^\d+]/g, ''))}">${escapeHtml(lead.phone)}</a>` : '',
      lead.email ? `<a href="mailto:${escapeHtml(lead.email)}">${escapeHtml(lead.email)}</a>` : '',
    ].filter(Boolean).join(' · ');
    return `<div class="contact"><span class="head">Contact</span>${who}${role}<div class="sub">${reach}</div></div>`;
  }

  function boardStatusCellHtml(lead: Lead): string {
    const select = [
      `<select class="status s-${escapeHtml(lead.status)}"`,
      `data-id="${escapeHtml(lead.id)}"`,
      `aria-label="Status of ${escapeHtml(lead.business)}">`,
    ].join(' ');
    return `<div class="st"><span class="head">Status</span>${select}${statusOptionsHtml(lead.status)}</select></div>`;
  }

  function boardTouchCellHtml(lead: Lead): string {
    const touch = lead.lastTouch;
    if (!touch) return '<div class="touch"><span class="head">Last touch</span><span class="muted">nothing yet</span></div>';
    const what = escapeHtml(config.touchLabel[touch.kind] || touch.kind);
    // Clamped to three lines in CSS; 400 characters is more than those lines can hold.
    const said = escapeHtml(touch.text.slice(0, 400));
    const when = `<span class="muted">${escapeHtml(timeAgo(touch.at))}</span>`;
    return `<div class="touch"><span class="head">Last touch</span>${what} ${when}<div class="sub">${said}</div></div>`;
  }

  function boardNextCellHtml(lead: Lead): string {
    const nothingToSay = !lead.nextStep && !lead.projects.length;
    const date = lead.nextAt
      ? `<span class="${lead.due ? `due-${lead.due}` : ''}">${escapeHtml(lead.nextAt)}</span>`
      : nothingToSay ? '<span class="muted">—</span>' : '';
    const projects = lead.projects
      .map((project) => {
        const open = `<a href="/admin#p/${escapeHtml(project.id)}">Project: ${escapeHtml(project.status)}</a>`;
        const preview = project.previewUrl
          ? ` · <a href="${escapeHtml(project.previewUrl)}" target="_blank" rel="noopener">preview</a>`
          : '';
        return `<div class="sub">${open}${preview}</div>`;
      })
      .join('');
    const step = `<div class="sub">${escapeHtml(lead.nextStep)}</div>`;
    return `<div class="next"><span class="head">Next</span>${date}${step}${projects}</div>`;
  }

  /** The filter chips across the top of the board, each with its own count. */
  function filterChips(leads: Lead[]): Choice[] {
    const countOf = (matches: (lead: Lead) => boolean) => leads.filter(matches).length;
    const byStatus = config.statuses.map((status): Choice => {
      const count = countOf((lead) => lead.status === status);
      return [status, `${config.statusLabel[status]} ${count}`];
    });
    return [
      ['active', `Active ${countOf(isLive)}`],
      ['all', `All ${leads.length}`],
      ['inbound', `Came to us ${countOf((lead) => lead.kind === 'inbound')}`],
      ['mock', `Mock-ups ${countOf((lead) => Boolean(lead.mockUrl))}`],
      ...byStatus,
      ['partner', `Partners ${countOf((lead) => lead.kind === 'partner')}`],
    ];
  }

  function boardHtml(leads: Lead[], seedAvailable: number): string {
    const liveCount = leads.filter(isLive).length;
    const dueCount = leads.filter((lead) => lead.due === 'overdue' || lead.due === 'today').length;
    const wonCount = leads.filter((lead) => lead.status === 'won').length;
    const importLabel = seedAvailable ? `Import · research list (${seedAvailable} new)` : 'Import';
    const counts = `<span class="muted">${liveCount} active · ${dueCount} due · ${wonCount} won</span>`;
    const buttons = [
      '<a class="btn" href="#new">Add a lead</a>',
      `<a class="btn" href="#import">${importLabel}</a>`,
      '<a class="btn" href="/api/admin/leads/export">CSV</a>',
    ].join('');
    const toolbar = `<div class="toolbar">${counts}<span class="spacer"></span>${buttons}</div>`;
    const what = '<p class="muted">A lead is a business, church or nonprofit that could buy a site (a <b>prospect</b>), one that came to us through the contact form (<b>came to us</b>), or a chamber, network or referral source that produces prospects (a <b>partner</b>). Open one to log what happened and set the next step; a first email or call moves it to Contacted on its own, a reply to Replied, a meeting to Meeting set. <b>Start a project</b> opens the intake with what the board knows filled in.</p>';
    const chips = filterChips(leads)
      .map(([key, label]) => `<button type="button" data-filter="${key}" aria-pressed="${key === 'active'}">${escapeHtml(label)}</button>`)
      .join('');
    const search = '<input type="search" id="search" placeholder="Search the board" aria-label="Search the board">';
    return `
    <h1>Leads</h1>
    ${toolbar}
    ${what}
    ${upNextHtml(leads, dueCount)}
    <section class="card"><h2>Board</h2>
      <div class="filters">${chips}${search}</div>
      ${leads.length ? boardRowsHtml(leads) : EMPTY_BOARD}
    </section>`;
  }

  const EMPTY_BOARD = '<p class="muted">No leads yet. <a href="#new">Add one</a>, <a href="#import">import a list</a>, or load the research list from the import page: the organizations the research named, each with where it came from and why.</p>';

  function boardRowsHtml(leads: Lead[]): string {
    const headings = '<div class="lead cols"><div>Business</div><div>Contact</div><div>Status</div><div>Last touch</div><div>Next</div></div>';
    const rows = leads.map(boardRowHtml).join('');
    return `${headings}${rows}<p class="muted" id="nomatch" hidden>Nothing matches this filter.</p>`;
  }

  /** The dozen leads with a date on them, so the day's work is readable without scrolling. */
  function upNextHtml(leads: Lead[], dueCount: number): string {
    const soon = leads.filter((lead) => lead.due).slice(0, 12);
    if (!soon.length) return '';
    const items = soon
      .map((lead) => {
        const name = `<a href="#l/${escapeHtml(lead.id)}"><b>${escapeHtml(lead.business)}</b></a>`;
        const when = `<span class="due-${escapeHtml(lead.due)}">${escapeHtml(lead.nextAt)}</span>`;
        const step = escapeHtml(lead.nextStep) || '<span class="muted">no step written down</span>';
        const status = `<span class="muted">${escapeHtml(config.statusLabel[lead.status])}</span>`;
        return `<li>${name}${when}<span>${step}</span>${status}</li>`;
      })
      .join('');
    const heading = `<h2>Up next <span class="muted">${dueCount} due or overdue</span></h2>`;
    return `<section class="card">${heading}<ul class="next">${items}</ul></section>`;
  }

  /** The chips and the search box hide rows in place; the board itself is only fetched once. */
  function wireFilters() {
    let chip = 'active';
    let query = '';

    const matchesChip = (row: HTMLElement) => {
      if (chip === 'all') return true;
      if (chip === 'active') return config.active.includes(row.dataset.status ?? '');
      if (chip === 'mock') return row.dataset.mock === '1';
      if (chip === 'partner' || chip === 'inbound') return row.dataset.kind === chip;
      return row.dataset.status === chip;
    };

    const apply = () => {
      let shown = 0;
      app.querySelectorAll<HTMLElement>('.lead[data-id]').forEach((row) => {
        const matches = matchesChip(row) && (!query || (row.dataset.search ?? '').includes(query));
        row.hidden = !matches;
        if (matches) shown++;
      });
      const nothingMatches = document.getElementById('nomatch');
      if (nothingMatches) nothingMatches.hidden = shown > 0;
    };

    const buttons = app.querySelectorAll<HTMLButtonElement>('.filters button');
    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        chip = button.dataset.filter ?? 'all';
        buttons.forEach((other) => other.setAttribute('aria-pressed', String(other === button)));
        apply();
      });
    });

    document.getElementById('search')?.addEventListener('input', (event) => {
      query = (event.target as HTMLInputElement).value.trim().toLowerCase();
      apply();
    });

    apply();
  }

  /** Changing a row's status saves it and loads the board again, so the order and counts follow. */
  function wireStatusSelects() {
    app.querySelectorAll<HTMLSelectElement>('select.status').forEach((select) => {
      select.addEventListener('change', async () => {
        select.disabled = true;
        const path = '/leads/' + encodeURIComponent(select.dataset.id ?? '');
        try {
          await callApi(path, { method: 'PATCH', body: JSON.stringify({ patch: { status: select.value } }) });
          await showBoard();
        } catch (error) {
          alert('Could not change the status: ' + reasonFor(error));
          select.disabled = false;
        }
      });
    });
  }

  // ---- one lead ----

  async function showLead(id: string) {
    app.innerHTML = '<p class="muted">Loading…</p>';
    const { lead, touches } = await callApi('/leads/' + encodeURIComponent(id));
    app.innerHTML = leadHtml(lead, touches);
    wireLog(id);
    wireDetails(id, lead);
    wireStartProject(id);
  }

  function leadHtml(lead: Lead, touches: Touch[]): string {
    const summary = summaryLine(lead);
    return `
    <p><a class="back" href="#">← Leads</a></p>
    <h1>${escapeHtml(lead.business || lead.contact || 'Untitled')}${kindBadge(lead)}</h1>
    ${summary ? `<p class="muted">${summary}</p>` : ''}
    ${mockRowHtml(lead)}
    ${lead.why ? `<p>${escapeHtml(lead.why)}</p>` : ''}
    ${lead.message ? `<p><span class="muted">They wrote:</span> ${escapeHtml(lead.message)}</p>` : ''}
    ${lead.source ? `<p class="muted">Source: ${escapeHtml(lead.source)}</p>` : ''}
    <section class="card"><h2>Project</h2>${projectHtml(lead)}<span class="muted" id="startnote"></span></section>
    <section class="card"><h2>Log</h2>
      ${logFormHtml(lead)}
      ${logHtml(touches)}
    </section>
    ${detailsHtml(lead)}`;
  }

  /** Every field the board keeps, editable, with Save and Delete under them. */
  function detailsHtml(lead: Lead): string {
    const save = '<button type="button" class="primary" id="save">Save details</button>';
    const remove = '<button type="button" class="danger" id="delete">Delete</button>';
    const buttons = `<div class="btns">${save}${remove}<span class="muted" id="editnote"></span></div>`;
    return `<section class="card"><h2>Details</h2><form class="fields" id="edit">${fieldsHtml(lead)}</form>
      ${buttons}
    </section>`;
  }

  /** What the mock-up is for, and what to do with it if they say yes. */
  function mockRowHtml(lead: Lead): string {
    if (!lead.mockUrl) return '';
    const open = `<a class="btn" href="${escapeHtml(lead.mockUrl)}" target="_blank" rel="noopener">Open the mock-up</a>`;
    const help = '<span class="help">Built before any project, on a private preview. If they say yes: push its folder (<code>~/repos/clients/client-&lt;slug&gt;</code> on the box) to GitHub under that name and start the project from this lead with the same business name. The link comes along: both sides get an Open the mock-up button, the intake asks what to change from it, and the first build carries it on instead of starting over.</span>';
    return `<p class="mockrow">${open} ${help}</p>`;
  }

  /** A lead's projects, or the button that starts one. A partner never becomes a project. */
  function projectHtml(lead: Lead): string {
    if (lead.projects.length) {
      return lead.projects
        .map((project) => {
          const name = `<a href="/admin#p/${escapeHtml(project.id)}"><b>${escapeHtml(project.business || lead.business)}</b></a>`;
          const preview = project.previewUrl
            ? ` · <a href="${escapeHtml(project.previewUrl)}" target="_blank" rel="noopener">preview</a>`
            : '';
          const status = `<div class="muted">${escapeHtml(project.status)}${preview}</div>`;
          const open = `<a class="btn" href="/admin#p/${escapeHtml(project.id)}">Open</a>`;
          return `<div class="row"><div>${name}${status}</div>${open}</div>`;
        })
        .join('');
    }
    if (lead.kind === 'partner') return '<p class="muted">A partner sends prospects; projects start from those.</p>';
    const start = '<button type="button" class="primary" id="start">Start a project from this lead</button>';
    const help = '<span class="help">Opens the intake with the business, contact, phone, email, current site, town and the notes here already filled in, and marks the lead Won.</span>';
    return `${start}${help}`;
  }

  /** One entry in the log, with the next step carried forward from the lead. */
  function logFormHtml(lead: Lead): string {
    const kinds = config.touchKinds
      .map((kind) => `<option value="${kind}">${escapeHtml(config.touchLabel[kind])}</option>`)
      .join('');
    return `<form class="touch" id="touch">
        <div><label for="t-kind">What</label><select id="t-kind" name="kind">${kinds}</select></div>
        <div><label for="t-text">Happened</label><input id="t-text" name="text" type="text" placeholder="What you did, what they said" maxlength="2000"></div>
        <div><label for="t-status">Status after</label><select id="t-status" name="status"><option value="">follows the entry</option>${statusOptionsHtml('')}</select></div>
        <div><label for="t-step">Next step</label><input id="t-step" name="nextStep" type="text" value="${escapeHtml(lead.nextStep)}" maxlength="300"></div>
        <div><label for="t-at">By</label><input id="t-at" name="nextAt" type="date" value="${escapeHtml(lead.nextAt)}"></div>
        <div class="btns wide"><button type="submit" class="primary">Add entry</button><span class="muted" id="touchnote"></span></div>
      </form>`;
  }

  function logHtml(touches: Touch[]): string {
    if (!touches.length) return '<p class="muted">Nothing logged yet.</p>';
    const items = touches
      .map((touch) => {
        // The stored timestamp, to the minute, in the plain form Daniel reads: 2026-11-19 09:12.
        const when = escapeHtml(String(touch.at).slice(0, 16).replace('T', ' '));
        const what = escapeHtml(config.touchLabel[touch.kind] || touch.kind);
        const moved = touch.status ? ` → ${escapeHtml(config.statusLabel[touch.status] || touch.status)}` : '';
        // Only a touch somebody else logged (Front Desk, say) is worth naming.
        const who = touch.who && touch.who !== 'daniel' ? ` · ${escapeHtml(touch.who)}` : '';
        return `<li><span class="when">${when} · ${what}${moved}${who}</span><br>${escapeHtml(touch.text)}</li>`;
      })
      .join('');
    return `<ul class="log">${items}</ul>`;
  }

  function wireLog(id: string) {
    document.getElementById('touch')!.addEventListener('submit', async (event) => {
      event.preventDefault();
      setNote('touchnote', 'Saving…');
      const form = event.target as HTMLFormElement;
      try {
        await callApi('/leads/' + encodeURIComponent(id) + '/touches', { method: 'POST', body: JSON.stringify(formValues(form)) });
        // Loaded again rather than patched in place: the entry can move the status and the step.
        showLead(id);
      } catch (error) {
        setNote('touchnote', 'Could not save: ' + reasonFor(error), true);
      }
    });
  }

  function wireDetails(id: string, lead: Lead) {
    document.getElementById('save')!.addEventListener('click', async () => {
      const form = document.getElementById('edit') as HTMLFormElement;
      if (!form.reportValidity()) return;
      setNote('editnote', 'Saving…');
      try {
        await callApi('/leads/' + encodeURIComponent(id), { method: 'PATCH', body: JSON.stringify({ patch: formValues(form) }) });
        showLead(id);
      } catch (error) {
        setNote('editnote', 'Could not save: ' + reasonFor(error), true);
      }
    });

    document.getElementById('delete')!.addEventListener('click', async () => {
      if (!confirm(`Delete ${lead.business} from the board, with its log? There is no undo.`)) return;
      try {
        await callApi('/leads/' + encodeURIComponent(id), { method: 'DELETE' });
        location.hash = '';
      } catch (error) {
        setNote('editnote', 'Could not delete: ' + reasonFor(error), true);
      }
    });
  }

  /** Start a project: the server fills the intake from the lead and marks the lead Won. */
  function wireStartProject(id: string) {
    const start = document.getElementById('start') as HTMLButtonElement | null;
    start?.addEventListener('click', async () => {
      start.disabled = true;
      setNote('startnote', 'Starting the project…');
      try {
        const project = await callApi('/projects', { method: 'POST', body: JSON.stringify({ leadId: id }) });
        location.href = '/admin#p/' + project.id;
      } catch (error) {
        setNote('startnote', 'Could not start the project: ' + reasonFor(error), true);
        start.disabled = false;
      }
    });
  }

  // ---- add one ----

  function showNewLead() {
    // The first note is only asked for here; on an existing lead it belongs in the log.
    const label = '<label for="f-notes">First note</label>';
    const box = '<textarea id="f-notes" name="notes" maxlength="2000" placeholder="How you found them, what you noticed about their site…"></textarea>';
    const first = `<div class="wide">${label}${box}</div>`;
    const fields = fieldsHtml({ kind: 'prospect', status: 'new', siteState: 'unknown' });
    app.innerHTML = `
    <p><a class="back" href="#">← Leads</a></p>
    <h1>Add a lead</h1>
    <section class="card"><form class="fields" id="add">${fields}${first}</form>
      <div class="btns"><button type="button" class="primary" id="addgo">Add lead</button><span class="muted" id="addnote"></span></div>
    </section>`;
    document.getElementById('addgo')!.addEventListener('click', async () => {
      const form = document.getElementById('add') as HTMLFormElement;
      if (!form.reportValidity()) return;
      setNote('addnote', 'Saving…');
      try {
        const added = await callApi('/leads', { method: 'POST', body: JSON.stringify(formValues(form)) });
        location.hash = 'l/' + added.lead.id;
      } catch (error) {
        setNote('addnote', 'Could not add: ' + reasonFor(error), true);
      }
    });
  }

  // ---- import ----

  async function showImport() {
    app.innerHTML = '<p class="muted">Loading…</p>';
    const { seedAvailable } = await callApi('/leads');
    app.innerHTML = importHtml(seedAvailable);
    document.getElementById('importgo')!.addEventListener('click', () => {
      const pasted = (document.getElementById('paste') as HTMLTextAreaElement).value;
      runImport({ text: pasted });
    });
    document.getElementById('seedgo')!.addEventListener('click', () => runImport({ seed: true }));
  }

  function importHtml(seedAvailable: number): string {
    const columns = '<code>business, contact, role, email, phone, website, town, category, kind, fit, status, nextStep, nextAt, source, why, notes</code>';
    const how = `<p class="muted">Paste CSV with a header row naming any of ${columns}, or a JSON array. A business already on the board is skipped, never changed, so a list can be pasted twice.</p>`;
    const box = '<label for="paste">The list</label><textarea id="paste" class="paste" placeholder="business,town,website,contact,phone,why"></textarea>';
    const seedLabel = seedAvailable ? `Load the research list (${seedAvailable} new)` : 'Load the research list (all loaded)';
    const seed = `<button type="button" id="seedgo"${seedAvailable ? '' : ' disabled'}>${seedLabel}</button>`;
    const buttons = `<div class="btns"><button type="button" class="primary" id="importgo">Import</button>${seed}<span class="muted" id="importnote"></span></div>`;
    const about = '<p class="help">The research list is the organizations named in the research (steadfast-ai docs/ideas and this site\'s docs/research): chambers, church networks, nonprofits and a few retreat centers, each with its source and why. No contact details; the research recorded none.</p>';
    return `
    <p><a class="back" href="#">← Leads</a></p>
    <h1>Import leads</h1>
    <section class="card">
      ${how}
      ${box}
      ${buttons}
      ${about}
      <pre class="result" id="result" hidden></pre>
    </section>`;
  }

  /** The pasted list or the research list, with what came of it printed underneath. */
  async function runImport(body: { text: string } | { seed: true }) {
    setNote('importnote', 'Importing…');
    try {
      const result = await callApi('/leads/import', { method: 'POST', body: JSON.stringify(body) });
      const output = document.getElementById('result')!;
      output.hidden = false;
      output.textContent = [
        `Added ${result.added}.`,
        result.skipped.length ? `\nAlready on the board, left alone: ${result.skipped.join(', ')}.` : '',
        result.problems.length ? `\nNot imported:\n${result.problems.join('\n')}` : '',
      ].join('');
      setNote('importnote', result.added ? 'Done.' : 'Nothing new to add.');
      // Long enough to read the result, then back to the board with the new leads on it.
      if (result.added) setTimeout(() => { location.hash = ''; }, 1500);
    } catch (error) {
      setNote('importnote', 'Could not import: ' + reasonFor(error), true);
    }
  }

  // ---- which view the hash asks for ----

  async function route() {
    const hash = location.hash;
    try {
      if (hash.startsWith('#l/')) await showLead(hash.slice(3));
      else if (hash === '#new') showNewLead();
      else if (hash === '#import') await showImport();
      else await showBoard();
    } catch (error) {
      const back = '<p><a class="back" href="#">← Leads</a></p>';
      app.innerHTML = `${back}<p class="error">${escapeHtml(reasonFor(error))}</p>`;
    }
  }

  addEventListener('hashchange', route);
  route();
</script>
</body>
</html>
