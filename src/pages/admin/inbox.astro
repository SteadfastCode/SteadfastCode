---
// /admin/inbox (2026-11-04): Daniel's messages with every client, laid out like any messages app.
// Conversations on the left (the ones waiting on him first, then the newest, then every other
// client so he can start one), the open conversation on the right with the message box pinned at
// the bottom: Enter sends, Shift+Enter is a new line. On a phone it's one pane at a time. The client
// gets an email with their link when he writes (server/messages.js). Behind Cloudflare Access.
import ThemeBoot from '../../components/ThemeBoot.astro';
const v = Date.now().toString(36);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content">
<meta name="robots" content="noindex, nofollow">
<title>Inbox — Steadfast Code admin</title>
<link rel="stylesheet" href={`/intake/form.css?v=${v}`}>
<ThemeBoot />
<style is:global>
  html, body { height: 100%; }
  body { display: flex; flex-direction: column; overflow: hidden; }
  .admin-head .in { max-width: 1440px; }
  /* A full-height app, not a page: none of form.css's page padding under it. */
  main.inbox { padding: 0; }
  .inbox { flex: 1; min-height: 0; width: 100%; max-width: 1440px; margin: 0 auto; display: grid; grid-template-columns: minmax(260px, 340px) minmax(0, 1fr); border-left: 1px solid var(--line); border-right: 1px solid var(--line); background: var(--card); }
  .convos { border-right: 1px solid var(--line); overflow-y: auto; min-height: 0; }
  .convos h1 { font-size: 1.15rem; margin: 0; padding: 14px 16px 10px; position: sticky; top: 0; background: var(--card); border-bottom: 1px solid var(--line); z-index: 1; }
  .convos .group { padding: 10px 16px 4px; font-size: .78rem; font-weight: 700; letter-spacing: .05em; text-transform: uppercase; color: var(--muted); }
  .convo { display: block; width: 100%; text-align: left; border: 0; border-radius: 0; background: none; color: var(--ink); padding: 10px 16px; border-bottom: 1px solid var(--line); cursor: pointer; font: inherit; }
  .convo:hover { background: var(--hover); }
  .convo[aria-current="true"] { background: var(--hover); box-shadow: inset 3px 0 0 var(--accent); }
  .convo .top { display: flex; justify-content: space-between; gap: 8px; align-items: baseline; }
  .convo b { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .convo .when { color: var(--muted); font-size: .8rem; flex: none; }
  .convo .last { color: var(--muted); font-size: .9rem; display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden; }
  .convo.unread b::before { content: ''; display: inline-block; width: 8px; height: 8px; border-radius: 50%; background: var(--accent); margin-right: 6px; vertical-align: middle; }
  .convo.unread .last { color: var(--ink); font-weight: 600; }
  .pane { display: flex; flex-direction: column; min-height: 0; min-width: 0; }
  .pane-head { display: flex; align-items: center; gap: 10px; padding: 10px 16px; border-bottom: 1px solid var(--line); }
  .pane-head .peer { flex: 1; min-width: 0; }
  .pane-head .peer b { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .pane-head .back { display: none; }
  .thread { flex: 1; min-height: 0; overflow-y: auto; padding: 14px 16px; }
  .thread ol.msgs { margin: 0; }
  /* "Track as a request" sits quietly under a message of theirs. */
  .msg .track { margin: 6px 0 0; }
  .msg .track button { font-size: .82rem; padding: 4px 10px; }
  .empty { margin: auto; color: var(--muted); padding: 24px; text-align: center; }
  .pane .composer { position: static; margin: 0; border-radius: 0; }
  @media (max-width: 760px) {
    .inbox { grid-template-columns: minmax(0, 1fr); border: 0; }
    .inbox.open .convos { display: none; }
    .inbox:not(.open) .pane { display: none; }
    .pane-head .back { display: inline-flex; }
  }
</style>
<script src={`/admin/app.js?v=${v}`} defer></script>
<script src={`/admin/tools.js?v=${v}`} defer></script>
</head>
<body>
<header class="admin-head"><div class="in"><span class="mark">Steadfast Code <span class="muted">admin</span></span><nav aria-label="Admin"><a href="/admin">Intake</a><a href="/admin/leads">Leads</a><a href="/admin/inbox" aria-current="page">Inbox</a><a href="/admin/care">Care plans</a><a href="/admin/usage">Usage</a></nav></div></header>
<main class="inbox" id="inbox">
  <section class="convos" aria-label="Conversations"><h1>Inbox</h1><div id="list"><p class="muted" style="padding:16px">Loading…</p></div></section>
  <section class="pane" aria-label="Conversation" id="pane"><div class="empty">Pick a conversation.</div></section>
</main>
<script>
  // /admin/inbox, written to be read; Astro bundles and minifies it for the build. Two panes, one
  // state: the conversations on the left come from /api/admin/inbox, and the hash says which one is
  // open (#p/<project id>), so the back button walks back out of a conversation. Each pane paints
  // its own HTML and then wires the controls it just painted.

  /** One client on the left: a project, with its last message when there is one. */
  type Conversation = {
    id: string;
    business: string | null;
    contact: string | null;
    unread: number;
    last: { at: string; sender: string; body: string } | null;
  };

  /** One message in the open conversation, as server/messages.js thread() sends it. */
  type Message = {
    id: number;
    at: string;
    sender: string;
    name: string | null;
    body: string;
    read_at: string | null;
    /** The change request this message became, if it did (server/requests.js). */
    request?: ChangeRequest;
  };

  /** A change request as the card under its message needs it. */
  type ChangeRequest = { id: number; title: string; status: string; note: string | null };

  /** How each status reads in Daniel's queue; the same words as the Requests card on the project. */
  const REQUEST_STATUS: Record<string, string> = {
    received: 'Received',
    working: 'Working on it',
    preview: 'On the preview',
    approved: 'Approved by them',
    live: 'Live',
    closed: 'Closed',
  };

  const conversationList = document.getElementById('list')!;
  const pane = document.getElementById('pane')!;
  const inbox = document.getElementById('inbox')!;

  let conversations: Conversation[] = [];
  let openId: string | null = null;
  // What the two panes last painted. A redraw that would change nothing is skipped, so a poll
  // can't replace the list under Daniel's pointer and swallow the click he was making.
  let paintedList = '';
  let paintedThread = '';

  // ---- the small jobs both panes need ----

  const HTML_ESCAPES: Record<string, string> = {
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  };

  /** Everything written into the page goes through here: a client's own words are not markup. */
  function escapeHtml(value: unknown): string {
    return String(value ?? '').replace(/[&<>"']/g, (character) => HTML_ESCAPES[character]);
  }

  /** How long ago, the way a messages app says it: minutes, then hours, then the date. */
  function ago(at: string): string {
    const seconds = (Date.now() - Date.parse(at)) / 1000;
    if (seconds < 60) return 'just now';
    if (seconds < 3600) return `${Math.round(seconds / 60)} min`;
    if (seconds < 86400) return `${Math.round(seconds / 3600)} h`;
    return new Date(at).toLocaleDateString(undefined, { month: 'short', day: 'numeric' });
  }

  /** One call to the admin API. Throws with the message the pane should show. */
  async function callApi<T>(path: string, init: RequestInit = {}): Promise<T> {
    const response = await fetch('/api/admin' + path, {
      ...init,
      headers: { 'content-type': 'application/json', ...(init.headers || {}) },
    });
    const body = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(problemFrom(body, response.status));
    return body;
  }

  // The one failure worth its own words: the messages tables live in a migration, so a database
  // without it answers "no such table" and the page would otherwise read like a bug.
  function problemFrom(body: { error?: string }, status: number): string {
    if (/no such table/.test(body.error || '')) return 'Messages are being switched on (the database migration hasn’t run yet).';
    return body.error || `Error ${status}`;
  }

  /** What to tell the reader when a call failed. */
  function reasonFor(error: unknown): string {
    return error instanceof Error ? error.message : String(error);
  }

  // ---- the left pane: every conversation ----

  async function loadConversations() {
    try {
      conversations = (await callApi<{ rows: Conversation[] }>('/inbox')).rows;
    } catch (error) {
      conversationList.innerHTML = `<p class="error" style="padding:16px">${escapeHtml(reasonFor(error))}</p>`;
      return;
    }
    // The minute is part of the key because the times read "4 min": at the turn of a minute the
    // same conversations are a different list.
    const painting = JSON.stringify([conversations, openId, Math.floor(Date.now() / 60000)]);
    if (painting === paintedList) return;
    paintedList = painting;
    conversationList.innerHTML = conversationsHtml();
    conversationList.querySelectorAll<HTMLButtonElement>('.convo').forEach((button) => {
      // The hash is the route, so opening a conversation is a place the back button can leave.
      button.addEventListener('click', () => { location.hash = 'p/' + button.dataset.id; });
    });
  }

  /** The conversations he has, then every other client, so he can start one with anybody. */
  function conversationsHtml(): string {
    const talked = conversations.filter((c) => c.last);
    const others = conversations.filter((c) => !c.last);
    const talkedHtml = talked.length ? talked.map(conversationHtml).join('') : '<p class="muted" style="padding:16px">No messages yet.</p>';
    const othersHtml = others.length ? `<div class="group">Start a conversation</div>${others.map(conversationHtml).join('')}` : '';
    return talkedHtml + othersHtml;
  }

  /** One button on the left: who, how long ago, and the start of the last message. */
  function conversationHtml(conversation: Conversation): string {
    const last = conversation.last;
    const when = last ? `<span class="when">${escapeHtml(ago(last.at))}</span>` : '';
    // No message yet: their contact's name stands in, so the row isn't a blank line.
    const preview = last ? `${last.sender === 'daniel' ? 'You: ' : ''}${escapeHtml(last.body)}` : escapeHtml(conversation.contact || '');
    const unread = conversation.unread ? ' unread' : '';
    return `<button type="button" class="convo${unread}" data-id="${escapeHtml(conversation.id)}" aria-current="${conversation.id === openId}"><span class="top"><b>${escapeHtml(conversation.business || 'Untitled')}</b>${when}</span><span class="last">${preview}</span></button>`;
  }

  // ---- the right pane: the open conversation ----

  function openConversation(id: string) {
    openId = id;
    paintedThread = '';
    inbox.classList.add('open');
    pane.innerHTML = paneHtml(id, conversations.find((c) => c.id === id));
    wirePane(id);
    // The highlight moves without redrawing the list, which would lose a click mid-press.
    conversationList.querySelectorAll<HTMLButtonElement>('.convo').forEach((button) => {
      button.setAttribute('aria-current', String(button.dataset.id === id));
    });
    // That highlight is not what the list last painted, so the next poll paints it properly.
    paintedList = '';
    loadThread(true);
    // Only a real keyboard gets the focus: on a phone it would open over the conversation.
    if (matchMedia('(min-width: 761px)').matches) document.getElementById('msgbody')!.focus();
  }

  /** Who this is, the thread, and the message box pinned under it. */
  function paneHtml(id: string, conversation: Conversation | undefined): string {
    const business = escapeHtml(conversation?.business || 'Client');
    const contact = escapeHtml(conversation?.contact || '');
    // "Message Pat": their first name, or "them" before the project has a contact name.
    const firstName = escapeHtml((conversation?.contact || 'them').split(' ')[0]);
    return `<div class="pane-head"><button type="button" class="back" id="back" aria-label="All conversations">‹</button><div class="peer"><b>${business}</b><span class="muted">${contact}</span></div><a href="/admin#p/${escapeHtml(id)}">Project</a></div>
      <div class="thread" id="thread"><ol class="msgs" id="msglist"><li class="muted">Loading…</li></ol></div>
      <div class="composer" id="composer"><div class="in"><label for="msgbody" class="sr">Reply</label><div class="composer-row"><textarea id="msgbody" maxlength="4000" rows="1" placeholder="Message ${firstName}" aria-describedby="msghint"></textarea><button type="button" class="primary" id="msgsend">Send</button></div><span id="msghint" class="help">Enter sends · Shift+Enter for a new line</span> <span id="msgnote" class="muted" role="status"></span></div></div>`;
  }

  /** Every control the pane paints: the way back on a phone, the box, and Send. */
  function wirePane(id: string) {
    const back = document.getElementById('back')!;
    const box = document.getElementById('msgbody') as HTMLTextAreaElement;
    const sendButton = document.getElementById('msgsend') as HTMLButtonElement;
    const note = document.getElementById('msgnote')!;

    // Back is a step in the history, not a reload: the list is still painted underneath.
    back.addEventListener('click', () => {
      history.pushState(null, '', '#');
      route();
    });

    /** The box grows with the message, up to a few lines, then scrolls inside itself. */
    function fitBox() {
      box.style.height = 'auto';
      box.style.height = Math.min(box.scrollHeight, 160) + 'px';
    }

    box.addEventListener('input', fitBox);
    box.addEventListener('keydown', (event) => {
      if (!sendsOnEnter(event)) return;
      event.preventDefault();
      sendButton.click();
    });
    // Tapping Send must not blur the box first: on a phone the keyboard would close, the page
    // would reflow, and the tap would land somewhere else.
    sendButton.addEventListener('pointerdown', (event) => {
      if (document.activeElement === box) event.preventDefault();
    });

    /** Send what's in the box, and say what became of it. */
    async function send() {
      if (!box.value.trim()) {
        note.textContent = 'Write a message first.';
        return;
      }
      sendButton.disabled = true;
      note.className = 'muted';
      note.textContent = 'Sending…';
      const text = box.value;
      try {
        const sent = await callApi<{ emailed: boolean; messages: Message[] }>(`/projects/${id}/messages`, {
          method: 'POST',
          body: JSON.stringify({ body: text }),
        });
        // Clear only what was sent: anything typed while it was sending stays.
        box.value = box.value.startsWith(text) ? box.value.slice(text.length).replace(/^\n/, '') : box.value;
        fitBox();
        if (openId === id) showThread(sent.messages, true);
        note.textContent = sent.emailed ? 'Sent · emailed' : 'Sent · no email went out';
        loadConversations();
      } catch (error) {
        note.className = 'error';
        note.textContent = reasonFor(error);
      }
      sendButton.disabled = false;
    }

    sendButton.addEventListener('click', send);
  }

  /**
   * Enter sends on a keyboard; on a touch screen it's a new line and Send sends, as in any
   * messaging app. An Enter that is finishing a word in an input method belongs to that method
   * (keyCode 229 is how the older browsers say so).
   */
  function sendsOnEnter(event: KeyboardEvent): boolean {
    if (event.key !== 'Enter' || event.shiftKey) return false;
    if (event.isComposing || event.keyCode === 229) return false;
    return !matchMedia('(hover: none) and (pointer: coarse)').matches;
  }

  // ---- the thread itself ----

  function showThread(messages: Message[], toEnd: boolean) {
    const list = document.getElementById('msglist');
    // The pane was replaced while this was in flight: there is nothing to paint into.
    if (!list) return;
    // Read receipts and a request's status are what change about a message, so they are the key with it.
    const painting = JSON.stringify(messages.map((m) => [m.id, m.read_at, m.request?.status, m.request?.title, m.request?.note]));
    if (painting === paintedThread) return;
    paintedThread = painting;
    const thread = document.getElementById('thread')!;
    // Stay where he is reading, unless he's at the bottom, where a new message should scroll in.
    const atEnd = toEnd || thread.scrollHeight - thread.scrollTop - thread.clientHeight < 40;
    list.innerHTML = messages.length
      ? messages.map(messageHtml).join('')
      : '<li class="muted">No messages yet. Say hello; they’ll get an email with their link.</li>';
    if (atEnd) thread.scrollTop = thread.scrollHeight;
    wireTrackButtons(list, messages);
  }

  /**
   * "Track as a request" under a message of theirs: asks for the request in a few words (their
   * first line to start from) and opens it on that message. From then on the message carries a
   * card with the request's status, here and on their page, and it's in the project's queue.
   */
  function wireTrackButtons(list: HTMLElement, messages: Message[]) {
    list.querySelectorAll<HTMLButtonElement>('[data-track]').forEach((button) => {
      button.addEventListener('click', async () => {
        const message = messages.find((m) => m.id === Number(button.dataset.track));
        if (!message || !openId) return;
        const firstLine = message.body.split('\n')[0].slice(0, 160);
        const title = prompt('The request in a few words (they’ll see this on its card):', firstLine);
        if (title === null) return;
        button.disabled = true;
        try {
          await callApi(`/projects/${openId}/requests`, { method: 'POST', body: JSON.stringify({ title, messageId: message.id }) });
          await loadThread(false);
        } catch (error) {
          alert(reasonFor(error));
          button.disabled = false;
        }
      });
    });
  }

  /** One message: his on the right, theirs on the left. */
  function messageHtml(message: Message): string {
    const mine = message.sender === 'daniel';
    const who = mine ? 'You' : escapeHtml(message.name || 'Client');
    // Only his own messages say "read": theirs are read by the time they are on his screen.
    const read = mine && message.read_at ? ' <span class="muted">· read</span>' : '';
    return `<li class="msg ${mine ? 'mine' : 'theirs'}"><div class="meta"><b>${who}</b> <span class="muted">${escapeHtml(ago(message.at))}</span>${read}</div><div class="body">${escapeHtml(message.body)}</div>${requestHtml(message, mine)}</li>`;
  }

  /** Under a message: its request's card, or, on one of theirs that isn't a request yet, the way to make it one. */
  function requestHtml(message: Message, mine: boolean): string {
    const request = message.request;
    if (!request) return mine ? '' : `<p class="track"><button type="button" data-track="${message.id}">Track as a request</button></p>`;
    const note = request.note ? `<p class="muted">Your note: ${escapeHtml(request.note)}</p>` : '';
    return `<div class="request-card">
      <p class="request-line"><span class="request-word">Request</span> <span class="badge">${escapeHtml(REQUEST_STATUS[request.status] || request.status)}</span></p>
      <p class="request-title">${escapeHtml(request.title)}</p>
      ${note}
    </div>`;
  }

  // Opening a conversation marks the client's messages read, but only while this window is the one
  // Daniel is looking at: a poll from an inbox left open on the desk only peeks, so the message
  // stays unread and the box still tells his phone.
  async function loadThread(toEnd: boolean) {
    if (!openId) return;
    const id = openId;
    const peek = document.hasFocus() ? '' : '?peek=1';
    try {
      const loaded = await callApi<{ messages: Message[] }>(`/projects/${id}/messages${peek}`);
      // He moved on while this was in flight: those messages are another conversation's.
      if (openId === id) showThread(loaded.messages, toEnd);
    } catch (error) {
      const list = document.getElementById('msglist');
      if (list) list.innerHTML = `<li class="error">${escapeHtml(reasonFor(error))}</li>`;
    }
  }

  // ---- which conversation the hash asks for ----

  async function route() {
    const open = location.hash.match(/^#p\/([\w-]+)$/);
    // The first route needs the list: the pane's header is a row out of it.
    if (!conversations.length) await loadConversations();
    if (open) {
      openConversation(open[1]);
      // Opening it marked their messages read; the list catches up once the server has.
      setTimeout(loadConversations, 600);
      return;
    }
    openId = null;
    inbox.classList.remove('open');
    pane.innerHTML = '<div class="empty">Pick a conversation.</div>';
    loadConversations();
  }

  // iPhones don't resize the page for the keyboard: size it to what's visible, so the box rides up.
  function fitToVisibleArea() {
    const visible = window.visualViewport;
    document.body.style.height = visible ? `${visible.height}px` : '';
  }

  window.visualViewport?.addEventListener('resize', fitToVisibleArea);
  fitToVisibleArea();
  // Back to this window: a message that only peeked while it sat in the background is read now.
  addEventListener('focus', () => {
    loadThread(false);
    loadConversations();
  });
  addEventListener('hashchange', route);
  route();
  // A message that arrives while he has the Inbox open shows up on its own.
  setInterval(() => {
    if (document.visibilityState !== 'visible') return;
    loadConversations();
    loadThread(false);
  }, 5000);
</script>
</body>
</html>
