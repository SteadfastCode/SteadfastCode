---
// /admin/usage (2026-11-02): what client builds cost Daniel. Behind the same Cloudflare Access app
// as /admin. Every dollar here is his real plan cost, not API pricing:
//
//   a build's share of the week ≈ its compute × (weekly-limit % used per unit of compute)
//   its cost                    ≈ that share × one week of the plan (monthly price × 12 ÷ 52)
//
// "Compute" is the session's API-equivalent figure, used only as a measuring stick of how much
// work a build did. The ratio is calibrated from the plan's own meter, read before and after each
// build: whole percents, and other sessions running at the same time count too, so one build's
// reading is noisy, but the sum over many builds isn't. The page says how many builds it rests on.
const v = Date.now().toString(36);
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Build usage — Steadfast Code admin</title>
<link rel="stylesheet" href={`/intake/form.css?v=${v}`}>
<style is:global>
  :root { --chart: #2563eb; }
  @media (prefers-color-scheme: dark) { :root { --chart: #4f8ef0; } }
  .tiles { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; }
  .tile { background: var(--card); border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; }
  .tile .n { display: block; font-size: 1.6rem; font-weight: 700; font-variant-numeric: tabular-nums; color: var(--ink); }
  .tile .l { color: var(--muted); font-size: .85rem; }
  table.data { width: 100%; border-collapse: collapse; font-size: .9rem; font-variant-numeric: tabular-nums; }
  table.data th, table.data td { text-align: left; padding: 7px 8px; border-bottom: 1px solid var(--line); vertical-align: top; }
  table.data th { color: var(--muted); font-weight: 600; }
  table.data td.num, table.data th.num { text-align: right; }
  .scroll { overflow-x: auto; }
  .chart { position: relative; height: 180px; display: flex; align-items: flex-end; gap: 2px; padding: 0 0 2px; border-bottom: 1px solid var(--line); }
  .chart .bar { flex: 1 1 0; min-width: 4px; max-width: 64px; background: var(--chart); border-radius: 4px 4px 0 0; position: relative; }
  .chart .hit { position: absolute; inset: -40px -1px 0; }
  .chart .bar:hover, .chart .bar:focus-visible { outline: 2px solid var(--ink); outline-offset: 1px; }
  .tip { position: absolute; z-index: 5; background: var(--card); color: var(--ink); border: 1px solid var(--line); border-radius: 8px; padding: 8px 10px; font-size: .85rem; box-shadow: 0 6px 18px rgba(0,0,0,.18); pointer-events: none; white-space: nowrap; }
  .tip b { font-weight: 700; }
  .axis { display: flex; justify-content: space-between; color: var(--muted); font-size: .8rem; margin-top: 4px; }
  details.chg summary { cursor: pointer; color: var(--accent); }
  details.chg pre { white-space: pre-wrap; font: inherit; font-size: .82rem; color: var(--muted); margin: 6px 0 0; }
  .plan { display: flex; gap: 8px; align-items: center; flex-wrap: wrap; }
  .plan input { width: 8rem; }
</style>
<script src={`/admin/app.js?v=${v}`} defer></script>
</head>
<body>
<header class="admin-head stick"><div class="in"><span class="mark">Steadfast Code <span class="muted">admin</span></span><nav aria-label="Admin"><a href="/admin">Intake</a><a href="/admin/leads">Leads</a><a href="/admin/inbox">Inbox</a><a href="/admin/care">Care plans</a><a href="/admin/usage" aria-current="page">Usage</a></nav></div></header>
<main id="app">
  <h1>Build usage</h1>
  <p class="muted">What client builds cost you: your share of the plan you pay for, not API pricing.</p>
  <section class="card">
    <div class="plan"><label for="plan" style="margin:0">Your plan, per month</label> $<input type="text" id="plan" inputmode="decimal" placeholder="200"> <button type="button" id="saveplan">Save</button> <span class="muted" id="plannote"></span></div>
  </section>
  <div id="body"><p class="muted">Loading…</p></div>
</main>
<script>
  // /admin/usage, written to be read; Astro bundles and minifies it for the build. The page asks
  // /api/admin/usage for every recorded client build, works out what each one cost Daniel against
  // the plan he pays for, and renders the lot into <div id="body">. The plan price is the one thing
  // it writes back, so a save re-renders from the data already in hand.
  //
  // The arithmetic is the one in the comment at the top of this page: a build's compute is only a
  // measuring stick, and the ratio between that stick and real weekly usage is calibrated from the
  // plan's own meter, read before and after each build.

  /** One build, as /api/admin/usage sends it (the `builds` table, plus the client's name). */
  type Build = {
    id: string;
    project_id: string;
    tier: string | null;
    kind: string;
    mode: string | null;
    requested_by: string | null;
    started_at: string;
    finished_at: string | null;
    seconds: number | null;
    ok: number;
    cost_usd: number | null;
    weekly_before: number | null;
    weekly_after: number | null;
    change_count: number | null;
    changes: string | null;
    rules_refreshed: number | null;
    business: string | null;
  };

  type Usage = { planMonthlyUsd: number | null; builds: Build[] };

  /** A build with what it cost worked out: its share of a week's limit, and that share in dollars. */
  type Costed = Build & { kindLabel: string; share: number | null; dollars: number | null };

  // ---- the small jobs the whole page needs ----

  const HTML_ESCAPES: Record<string, string> = {
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  };

  /** Everything written into the page goes through here: a client's own words are not markup. */
  function escapeHtml(value: unknown): string {
    return String(value ?? '').replace(/[&<>"']/g, (character) => HTML_ESCAPES[character]);
  }

  /** Dollars, or cents under a dollar: most single builds cost less than one. */
  function formatUsd(amount: number | null | undefined): string {
    if (amount == null || !isFinite(amount)) return '—';
    if (amount < 0.995) return `${Math.round(amount * 100)}¢`;
    return `$${amount.toFixed(2)}`;
  }

  /** A share of the week's limit. Under a tenth of a percent it is the sign that matters, not the figure. */
  function formatPercent(share: number | null | undefined): string {
    if (share == null || !isFinite(share)) return '—';
    if (share < 0.1) return '<0.1%';
    return `${share.toFixed(1)}%`;
  }

  /** How long a build ran, in the units it is thought about: seconds, or minutes and seconds. */
  function formatDuration(seconds: number | null | undefined): string {
    if (seconds == null) return '—';
    if (seconds < 60) return `${seconds}s`;
    return `${Math.floor(seconds / 60)}m ${String(seconds % 60).padStart(2, '0')}s`;
  }

  /** The order the grouped tables read in; a group with no builds in it is left out. */
  const KIND_ORDER = ['First build', 'Update', 'Full rebuild'];
  const CHANGE_ORDER = ['Nothing in the brief', '1–2 changes', '3–5 changes', '6 or more', 'Unknown'];

  const MODE_LABEL: Record<string, string> = {
    first: 'First build',
    targeted: 'Update',
    full: 'Full rebuild',
  };

  /** Builds recorded before `mode` existed only say whether they were the first one. */
  function kindLabelFor(build: Build): string {
    return MODE_LABEL[build.mode ?? ''] || (build.kind === 'first' ? 'First build' : 'Update');
  }

  /** Updates grouped by how much the brief asked for, which is what their cost tracks. */
  function changeBucket(count: number | null): string {
    if (count == null) return 'Unknown';
    if (count === 0) return 'Nothing in the brief';
    if (count <= 2) return '1–2 changes';
    if (count <= 5) return '3–5 changes';
    return '6 or more';
  }

  /** One call to the admin API. Throws with the server's own message, which the page shows. */
  async function callApi(path: string, init: RequestInit = {}): Promise<any> {
    const response = await fetch('/api/admin' + path, {
      credentials: 'same-origin',
      headers: { 'content-type': 'application/json' },
      ...init,
    });
    const body = await response.json().catch(() => ({}));
    if (!response.ok) throw new Error(body.error || 'HTTP ' + response.status);
    return body;
  }

  // ---- what a build cost ----

  /** One week of the plan: the monthly price times 12 months over the 52 weeks it buys. */
  function weekOfPlanUsd(monthly: number | null): number | null {
    return monthly ? (monthly * 12) / 52 : null;
  }

  /**
   * How much of a week's limit one unit of compute works out to, from the plan's own meter: every
   * build whose reading was taken before and after, added up. The meter moves in whole percents and
   * counts other sessions running at the same time, so this is only worth anything over many builds.
   */
  function calibrate(builds: Costed[]) {
    const measured = builds.filter((b) => b.cost_usd != null && b.weekly_before != null && b.weekly_after != null);
    // A reading that went backwards means the week rolled over mid-build: it adds nothing.
    const weeklyUsed = measured.reduce((total, b) => total + Math.max(0, b.weekly_after! - b.weekly_before!), 0);
    const compute = measured.reduce((total, b) => total + b.cost_usd!, 0);
    const percentPerUnit = compute > 0 && weeklyUsed > 0 ? weeklyUsed / compute : null;
    return { measured, weeklyUsed, percentPerUnit };
  }

  /** Fill in each build's share and dollars; both stay null while there is nothing to work from. */
  function priceBuilds(builds: Costed[], percentPerUnit: number | null, weekUsd: number | null) {
    for (const build of builds) {
      build.share = percentPerUnit != null && build.cost_usd != null ? build.cost_usd * percentPerUnit : null;
      build.dollars = build.share != null && weekUsd ? (build.share / 100) * weekUsd : null;
    }
  }

  const sumOf = (builds: Costed[], field: 'seconds' | 'share' | 'dollars') =>
    builds.reduce((total, build) => total + (build[field] ?? 0), 0);

  /** Builds before usage was recorded have no compute figure; they count for time only. */
  const withCost = (builds: Costed[]) => builds.filter((build) => build.dollars != null);

  // ---- the views ----

  /** The four figures at the top of a card: how many builds, what they cost, the share, the time. */
  function tilesHtml(label: string, builds: Costed[]): string {
    const priced = withCost(builds);
    const cost = priced.length ? sumOf(priced, 'dollars') : null;
    const share = priced.length ? sumOf(priced, 'share') : null;
    return `
    <div class="tile"><span class="n">${builds.length}</span><span class="l">builds, ${escapeHtml(label)}</span></div>
    <div class="tile"><span class="n">${formatUsd(cost)}</span><span class="l">your cost, ${escapeHtml(label)}</span></div>
    <div class="tile"><span class="n">${formatPercent(share)}</span><span class="l">of a week’s limit, ${escapeHtml(label)}</span></div>
    <div class="tile"><span class="n">${formatDuration(sumOf(builds, 'seconds'))}</span><span class="l">building, ${escapeHtml(label)}</span></div>`;
  }

  /** Builds grouped one way or another, averaged: the same six columns every time. */
  function groupTableHtml(builds: Costed[], keyOf: (build: Costed) => string, order?: string[]): string {
    const groups = new Map<string, Costed[]>();
    for (const build of builds) {
      const key = keyOf(build);
      if (!groups.has(key)) groups.set(key, []);
      groups.get(key)!.push(build);
    }
    // A given order reads better than whatever came back first, but only for the groups there are.
    const keys = order ? order.filter((key) => groups.has(key)) : [...groups.keys()];
    const rows = keys.map((key) => groupRowHtml(key, groups.get(key)!)).join('');
    const head = headRowHtml(['', 'Builds', 'Avg time', 'Avg cost', 'Avg share', 'Total cost']);
    return `<div class="scroll"><table class="data"><thead>${head}</thead><tbody>${rows}</tbody></table></div>`;
  }

  function groupRowHtml(key: string, group: Costed[]): string {
    const priced = withCost(group);
    const averageSeconds = Math.round(sumOf(group, 'seconds') / group.length);
    const averageCost = priced.length ? formatUsd(sumOf(priced, 'dollars') / priced.length) : '—';
    const averageShare = priced.length ? formatPercent(sumOf(priced, 'share') / priced.length) : '—';
    const totalCost = priced.length ? formatUsd(sumOf(priced, 'dollars')) : '—';
    const cells = [group.length, formatDuration(averageSeconds), averageCost, averageShare, totalCost];
    return `<tr><td>${escapeHtml(key)}</td>${numberCells(cells)}</tr>`;
  }

  /** The header row of either table; a column with no heading is the row's own label. */
  function headRowHtml(columns: string[]): string {
    const cells = columns.map((column, index) => (index === 0 ? `<th>${column}</th>` : `<th class="num">${column}</th>`));
    return `<tr>${cells.join('')}</tr>`;
  }

  /** Figures are read against each other, so every one of them is right-aligned. */
  function numberCells(values: (string | number)[]): string {
    return values.map((value) => `<td class="num">${value}</td>`).join('');
  }

  /** The bars: cost per build, oldest to newest. One series, so no legend; the table below is its table view. */
  function chartHtml(recent: Costed[], weekUsd: number | null): string {
    // Dollars once the plan price is set, the share of a week until then.
    const metric = (build: Costed) => (weekUsd ? build.dollars : build.share);
    const tallest = Math.max(0, ...recent.map((build) => metric(build) ?? 0));
    if (tallest <= 0) return '<p class="muted">The chart fills in once builds have usage recorded and the plan price is set.</p>';
    const bars = recent
      .map((build, index) => {
        const value = metric(build);
        // Even the cheapest build gets 2% of the height, so a bar is there to hover.
        const height = value ? Math.max(2, (value / tallest) * 100) : 0;
        return `<span class="bar" tabindex="0" data-i="${index}" style="height:${height}%"><span class="hit"></span></span>`;
      })
      .join('');
    return `<div class="chart" id="chart" aria-label="Cost per build, last ${recent.length}">${bars}</div>` + axisHtml(recent, tallest, weekUsd);
  }

  /** Under the bars: the day the oldest one ran, what the tallest is worth, and the newest day. */
  function axisHtml(recent: Costed[], tallest: number, weekUsd: number | null): string {
    const first = escapeHtml(new Date(recent[0].started_at).toLocaleDateString());
    const last = escapeHtml(new Date(recent.at(-1)!.started_at).toLocaleDateString());
    const scale = weekUsd ? `tallest ${formatUsd(tallest)}` : `tallest ${formatPercent(tallest)} of a week`;
    return `<div class="axis"><span>${first}</span><span>${scale}</span><span>${last}</span></div>`;
  }

  /** What the figures rest on, said plainly, because one build's reading is noisy. */
  function calibrationNoteHtml(measuredCount: number, weeklyUsed: number, calibrated: boolean, monthly: number | null): string {
    const plural = measuredCount === 1 ? '' : 's';
    const how = calibrated
      ? `Calibrated on ${measuredCount} build${plural} where your plan’s meter was read before and after: ${weeklyUsed}% of a week across them. The meter moves in whole percents and counts anything else running at the same time, so treat one build’s figure as rough; the totals settle as builds add up.`
      : 'Not enough measurements yet: costs appear once a few builds have run with usage recorded.';
    const needsPrice = monthly ? '' : ' Enter your plan price above to see dollars.';
    return `<p class="muted">${how}${needsPrice}</p>`;
  }

  /** Every build, newest first: when, for whom, what kind, what changed, time, share, cost. */
  function buildsTableHtml(builds: Costed[]): string {
    const plain = ['When', 'Site', 'Kind', 'By', 'What changed'].map((column) => `<th>${column}</th>`).join('');
    const head = `<tr>${plain}<th class="num">Time</th><th class="num">Share</th><th class="num">Cost</th></tr>`;
    const rows = builds.map(buildRowHtml).join('');
    return `<div class="scroll"><table class="data"><thead>${head}</thead><tbody>${rows}</tbody></table></div>`;
  }

  function buildRowHtml(build: Costed): string {
    const started = new Date(build.started_at);
    const when = escapeHtml(started.toLocaleString([], { month: 'short', day: 'numeric', hour: 'numeric', minute: '2-digit' }));
    const failed = build.ok ? '' : ' <span class="error">failed</span>';
    const rules = build.rules_refreshed ? ' <span class="muted">+ rules</span>' : '';
    const who = build.requested_by === 'client' ? 'Client' : 'You';
    const figures = [formatDuration(build.seconds), formatPercent(build.share), formatUsd(build.dollars)];
    return `
      <tr><td>${when}${failed}</td><td>${escapeHtml(build.business || '—')}</td><td>${escapeHtml(build.kindLabel)}${rules}</td><td>${who}</td>
      <td>${changesCellHtml(build)}</td>
      ${numberCells(figures)}</tr>`;
  }

  /** The brief for an update, folded away; the backticks it was written with would only be noise. */
  function changesCellHtml(build: Costed): string {
    if (!build.changes) return build.change_count === 0 ? 'none' : '—';
    const plural = build.change_count === 1 ? '' : 's';
    const brief = escapeHtml(build.changes.replace(/`/g, ''));
    return `<details class="chg"><summary>${build.change_count} change${plural}</summary><pre>${brief}</pre></details>`;
  }

  // ---- the tooltip on a bar ----

  function wireChartTooltip(recent: Costed[]) {
    const chart = document.getElementById('chart');
    const tip = document.getElementById('tip')!;
    if (!chart) return;
    const show = (bar: HTMLElement) => {
      const build = recent[Number(bar.dataset.i)];
      const changes = build.change_count != null ? `${build.change_count} change${build.change_count === 1 ? '' : 's'} · ` : '';
      const lines = [
        `<b>${escapeHtml(build.business || '—')}</b> · ${escapeHtml(build.kindLabel)}`,
        escapeHtml(new Date(build.started_at).toLocaleString()),
        `${changes}${formatDuration(build.seconds)}`,
        `${formatUsd(build.dollars)} · ${formatPercent(build.share)} of a week`,
      ];
      tip.innerHTML = lines.join('<br>');
      // Shown before it is measured: a hidden element has no width to centre on.
      tip.hidden = false;
      const barBox = bar.getBoundingClientRect();
      const cardBox = chart.parentElement!.getBoundingClientRect();
      // Centered over the bar, then pulled back inside the card at either end.
      const centered = barBox.left - cardBox.left - tip.offsetWidth / 2 + barBox.width / 2;
      tip.style.left = Math.min(Math.max(0, centered), cardBox.width - tip.offsetWidth) + 'px';
      tip.style.top = barBox.top - cardBox.top - tip.offsetHeight - 8 + 'px';
    };
    const hide = () => { tip.hidden = true; };
    // Hover and keyboard focus both show it, so the chart can be read without a mouse.
    chart.querySelectorAll<HTMLElement>('.bar').forEach((bar) => {
      bar.addEventListener('mouseenter', () => show(bar));
      bar.addEventListener('focus', () => show(bar));
      bar.addEventListener('mouseleave', hide);
      bar.addEventListener('blur', hide);
    });
  }

  // ---- loading, rendering, and the one thing the page saves ----

  let usage: Usage;

  async function loadUsage() {
    try {
      usage = await callApi('/usage');
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      document.getElementById('body')!.innerHTML = `<p class="error">${escapeHtml(message)}</p>`;
      return;
    }
    (document.getElementById('plan') as HTMLInputElement).value = String(usage.planMonthlyUsd ?? '');
    render();
  }

  function render() {
    const monthly = usage.planMonthlyUsd;
    const weekUsd = weekOfPlanUsd(monthly);
    const builds: Costed[] = usage.builds.map((build) => ({ ...build, kindLabel: kindLabelFor(build), share: null, dollars: null }));
    const { measured, weeklyUsed, percentPerUnit } = calibrate(builds);
    priceBuilds(builds, percentPerUnit, weekUsd);

    const weekAgo = Date.now() - 7 * 86400_000;
    const thisWeek = builds.filter((build) => Date.parse(build.started_at) > weekAgo);
    // The chart reads left to right in time, so the newest 40 are turned back around.
    const recent = builds.slice(0, 40).reverse();
    const updates = builds.filter((build) => build.mode === 'targeted');

    const note = calibrationNoteHtml(measured.length, weeklyUsed, percentPerUnit != null, monthly);
    const byKind = groupTableHtml(builds, (build) => build.kindLabel, KIND_ORDER);
    const byChange = groupTableHtml(updates, (build) => changeBucket(build.change_count), CHANGE_ORDER);
    const byWho = groupTableHtml(builds, (build) => (build.requested_by === 'client' ? 'The client' : 'You'));
    // The tip is a child of the chart's card, which is what it is positioned against.
    const chart = `${chartHtml(recent, weekUsd)}<div class="tip" id="tip" hidden></div>`;

    document.getElementById('body')!.innerHTML = `
    <section class="card"><h2>This week</h2><div class="tiles">${tilesHtml('last 7 days', thisWeek)}</div></section>
    <section class="card"><h2>All time</h2><div class="tiles">${tilesHtml('all time', builds)}</div>
      ${note}</section>
    <section class="card" style="position:relative"><h2>Cost per build</h2>${chart}</section>
    <section class="card"><h2>By kind of build</h2>${byKind}</section>
    <section class="card"><h2>Updates, by how much changed</h2>${byChange}</section>
    <section class="card"><h2>By who asked</h2>${byWho}</section>
    <section class="card"><h2>Every build</h2>${buildsTableHtml(builds)}</section>`;

    wireChartTooltip(recent);
  }

  /** The plan price, saved and then used: a dollar sign or a comma typed in is not an error. */
  async function savePlanPrice() {
    const note = document.getElementById('plannote')!;
    const typed = (document.getElementById('plan') as HTMLInputElement).value.replace(/[$,\s]/g, '');
    try {
      const saved = await callApi('/usage', { method: 'POST', body: JSON.stringify({ planMonthlyUsd: typed }) });
      usage.planMonthlyUsd = saved.planMonthlyUsd;
      note.textContent = 'Saved.';
      render();
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      note.innerHTML = `<span class="error">${escapeHtml(message)}</span>`;
    }
  }

  document.getElementById('saveplan')!.addEventListener('click', savePlanPrice);
  loadUsage();
</script>
</body>
</html>
