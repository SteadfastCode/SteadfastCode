---
// The client's side of their project (2026-11-01): the same form Daniel works from at /admin,
// live, from a private link (/client#<token>, made on the admin page). The token stays in the
// fragment, which browsers never send to the server; the page passes it to /api/client as a bearer
// header. Not a public page: noindex, out of the sitemap, outside the public-page tests.
import { intakeSections } from '../data/intake';
import { websiteTiers, addOns, business, standardDiscounts } from '../data/site';

// One version per build, on the shared script's and stylesheet's addresses, so a deploy is never
// served from a browser's cached copy of the old ones.
const v = Date.now().toString(36);

const config = {
  script: `/intake/project.js?v=${v}`,
  sections: intakeSections,
  tiers: websiteTiers.map((t) => ({ id: t.id, name: t.name, price: t.price, from: !!('from' in t && t.from), scope: t.scope })),
  editorPrice: addOns.find((a) => a.id === 'editor')?.price ?? null,
  discounts: [...standardDiscounts],
};
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, interactive-widget=resizes-content">
<meta name="robots" content="noindex, nofollow">
<meta name="referrer" content="no-referrer">
<title>Your website — Steadfast Code</title>
<link rel="stylesheet" href={`/intake/form.css?v=${v}`}>
</head>
<body>
<div id="progress" role="button" tabindex="0" hidden></div>
<main id="app"><p class="muted">Loading…</p></main>
<footer class="bar" id="bar" hidden><div class="in"><span id="saved" class="muted"></span><span id="readiness" class="muted"></span><button class="primary" id="build" hidden></button></div></footer>
<p class="muted" id="questions" style="text-align:center;padding:0 16px 120px">Questions? Email <a href={`mailto:${business.email}`}>{business.email}</a>.</p>
<script type="application/json" id="intake-config" set:html={JSON.stringify(config)}></script>
<script type="module" is:inline>

const C = JSON.parse(document.getElementById('intake-config').textContent);
const { mountProject, wireProgress } = await import(C.script);
const app = document.getElementById('app');
// The link's token is the fragment. It's kept for this browser tab too (2026-11-04), because a trip
// to Stripe for the card comes back to /client?care=… with no fragment: the token can't go to Stripe
// in the return address, and without it the page couldn't tell whose portal this is.
const fromHash = location.hash.slice(1);
const valid = (t) => /^[A-Za-z0-9_-]{20,100}$/.test(t || '');
let token = fromHash;
try {
  if (valid(fromHash)) sessionStorage.setItem('clientLink', fromHash);
  else if (valid(sessionStorage.getItem('clientLink'))) { token = sessionStorage.getItem('clientLink'); history.replaceState(null, '', location.pathname + location.search + '#' + token); }
} catch {}
if (!valid(token)) {
  // No link (2026-11-04): email the one on their project to the address they give.
  app.innerHTML = `<h1>Your website</h1>
    <section class="card"><h2>Get your link</h2>
      <p>Your project opens from a private link. Type the email address on your project and we'll send it to you.</p>
      <form id="linkform"><label for="linkemail">Email</label><input type="email" id="linkemail" autocomplete="email" required>
        <p><button type="submit" class="primary" id="linkgo">Email me my link</button></p>
        <p id="linknote" role="status" class="muted"></p></form>
    </section>`;
  const form = document.getElementById('linkform'), note = document.getElementById('linknote'), go = document.getElementById('linkgo');
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    go.disabled = true; note.className = 'muted'; note.textContent = 'Sending…';
    try {
      const r = await fetch('/api/link/request', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify({ email: document.getElementById('linkemail').value }) });
      const j = await r.json().catch(() => ({}));
      if (!r.ok) throw new Error(j.error || 'Something went wrong. Try again in a minute.');
      note.textContent = j.message;
    } catch (err) { note.className = 'error'; note.textContent = err.message; go.disabled = false; }
  });
} else {
  const progress = document.getElementById('progress');
  wireProgress(progress);
  const q = '?t=' + encodeURIComponent(token);
  mountProject({
    root: app, bar: document.getElementById('bar'), progress, config: C, mode: 'client',
    headers: { authorization: 'Bearer ' + token },
    routes: {
      project: '/api/client/project', presence: '/api/client/presence', uploads: '/api/client/uploads', build: '/api/client/build', agreement: '/api/client/agreement', care: '/api/client/care', messages: '/api/client/messages',
      // An <img> can't send the header, so a picture's address carries the token; changes don't.
      file: (id, forApi) => '/api/client/uploads/' + encodeURIComponent(id) + (forApi ? '' : q),
    },
  });
}
</script>
</body>
</html>
