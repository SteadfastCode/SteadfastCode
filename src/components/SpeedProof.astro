---
// The pitch, measured on the visitor's own device: how many bytes this page took and how long it
// took to load, next to the median website. The script is first-party and a few lines, bundled into
// the page by Astro; it reads the browser's own timing data and writes four numbers. Without
// JavaScript the block still reads true: the figures in the markup are the ones test/perf.test.js
// enforces on the built site.
import { benchmarks } from '../data/site';
const median = benchmarks.medianPageKb;
const medianMb = (median / 1024).toFixed(1);
---
<div class="proof" data-proof>
  <div class="stat" data-reveal style="--i:0">
    <span class="n hot" data-ms>&lt;1 s</span>
    <span class="l" data-ms-label>to load this page on your connection. Measured just now, by your browser.</span>
  </div>
  <div class="stat" data-reveal style="--i:1">
    <span class="n cool" data-kb>&lt;{benchmarks.budgetKb} KB</span>
    <span class="l">over the wire for this whole page, fonts and styles included.</span>
  </div>
  <div class="stat" data-reveal style="--i:2">
    <span class="n" data-median data-median-kb={median}>{medianMb} MB</span>
    <span class="l">the median website, per the <a href={benchmarks.sourceUrl} rel="noopener">{benchmarks.source}</a>. Most of it JavaScript and oversized images.</span>
  </div>
</div>
<div class="compare" data-reveal>
  <div class="bar them"><span>Median website</span><span class="track"><span class="fill" style="--w:100%"></span></span><span class="v">{median.toLocaleString('en-US')} KB</span></div>
  <!-- This page's share of the median. On a scripted page the bar starts full and shrinks to its
       value when it scrolls into view; the no-JS text is the ceiling the perf test guarantees. -->
  <div class="bar us"><span>This page</span><span class="track" role="progressbar" aria-label="This page's size as a share of the median website" aria-valuemin="0" aria-valuemax="100" aria-valuenow={Math.ceil((benchmarks.budgetKb / median) * 100)} data-bar-us><span class="fill" style={`--w:${Math.ceil((benchmarks.budgetKb / median) * 100)}%`}></span></span><span class="v"><span data-share>&lt;{Math.ceil((benchmarks.budgetKb / median) * 100)}%</span> of the median · <span data-kb-small>&lt;{benchmarks.budgetKb} KB</span></span></div>
</div>
<p class="proof-note">That gap is most of what I am selling. A page that is loaded the moment a visitor's thumb is lifted is a delightful experience. A page, or a whole site, that makes them wait can frustrate potential customers. Google ranks on it, too.</p>
<script>
  // Bundled, not inline, so the production build minifies it. Nothing here has to run before paint:
  // the figures in the markup are already true, and these replace them with the visitor's own.
  const find = (selector: string) => document.querySelector<HTMLElement>(selector);

  // Waits for load, so the numbers cover the whole page rather than a snapshot part way through,
  // and then for a turn of the event loop, so loadEventEnd is filled in.
  addEventListener('load', () => setTimeout(showThisVisit, 0));

  function showThisVisit() {
    try {
      const navigation = performance.getEntriesByType('navigation')[0] as PerformanceNavigationTiming | undefined;
      // An old browser with no Navigation Timing: leave the markup's figures alone.
      if (!navigation) return;

      const resources = performance.getEntriesByType('resource') as PerformanceResourceTiming[];
      const pageBytes = navigation.transferSize || 0;
      const assetBytes = resources.reduce((total, asset) => total + (asset.transferSize || 0), 0);
      const kb = Math.round((pageBytes + assetBytes) / 1024);
      const ms = Math.round(navigation.loadEventEnd || navigation.domContentLoadedEventEnd || performance.now());

      const time = find('[data-ms]');
      if (ms > 0 && time) time.textContent = ms < 1000 ? `${ms} ms` : `${(ms / 1000).toFixed(2)} s`;

      // A cached visit transfers almost nothing; say so instead of claiming a 2 KB website.
      if (kb < 5) {
        if (navigation.transferSize !== 0) return;
        const size = find('[data-kb]');
        const label = find('[data-ms-label]');
        if (size) size.textContent = 'cached';
        if (label) label.textContent = 'to load this page from your browser’s cache. Measured just now.';
        return;
      }

      for (const size of [find('[data-kb]'), find('[data-kb-small]')]) {
        if (size) size.textContent = `${kb} KB`;
      }

      // This page as a share of the median website, the same sum the markup already shows. The
      // median comes from src/data/site.ts by way of the data attribute, so there is no second
      // copy of the figure here; without it the markup's own share stands.
      const median = Number(find('[data-median]')?.dataset.medianKb);
      if (!median) return;
      const share = Math.max(1, Math.min(100, Math.round((kb / median) * 100)));
      const percent = find('[data-share]');
      if (percent) percent.textContent = `${share}%`;
      const bar = find('[data-bar-us]');
      if (bar) {
        bar.setAttribute('aria-valuenow', String(share));
        (bar.firstElementChild as HTMLElement | null)?.style.setProperty('--w', `${share}%`);
      }
    } catch (error) {
      // The figures already in the markup are true, so a browser that surprises us shows those.
    }
  }
</script>
