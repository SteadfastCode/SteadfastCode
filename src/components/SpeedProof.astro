---
// The pitch, measured on the visitor's own device: how many bytes this page took and how long it
// took to load, next to the median website. The script is first-party, inline and a few lines; it
// reads the browser's own timing data and writes four numbers. Without JavaScript the block still
// reads true: the fallback figures are the ones test/perf.test.js enforces on the built site.
import { benchmarks } from '../data/site';
const median = benchmarks.medianPageKb;
const medianMb = (median / 1024).toFixed(1);
---
<div class="proof" data-proof>
  <div class="stat" data-reveal style="--i:0">
    <span class="n hot" data-ms>&lt;1 s</span>
    <span class="l" data-ms-label>to load this page on your connection. Measured just now, by your browser.</span>
  </div>
  <div class="stat" data-reveal style="--i:1">
    <span class="n cool" data-kb>&lt;{benchmarks.budgetKb} KB</span>
    <span class="l">over the wire for this whole page, fonts and styles included.</span>
  </div>
  <div class="stat" data-reveal style="--i:2">
    <span class="n" data-median>{medianMb} MB</span>
    <span class="l">the median website, per the <a href={benchmarks.sourceUrl} rel="noopener">{benchmarks.source}</a>. Most of it JavaScript and oversized images.</span>
  </div>
</div>
<div class="compare" aria-hidden="true">
  <div class="bar them"><span>Median website</span><span class="track"><span class="fill" style="--w:100%"></span></span><span class="v">{median.toLocaleString('en-US')} KB</span></div>
  <div class="bar us"><span>This page</span><span class="track"><span class="fill" data-bar-us style={`--w:${Math.max(1.5, (benchmarks.budgetKb / median) * 100).toFixed(1)}%`}></span></span><span class="v" data-kb-small>&lt;{benchmarks.budgetKb} KB</span></div>
</div>
<p class="proof-note">That gap is most of what I am selling. A page that loads before someone's thumb leaves the screen gets read; a page that makes them wait gets closed. Google ranks on it, too.</p>
<script is:inline>
  // Runs once the page has fully loaded, so the numbers are the whole page, not a snapshot mid-way.
  addEventListener('load', () => setTimeout(() => {
    try {
      const nav = performance.getEntriesByType('navigation')[0];
      if (!nav) return;
      const res = performance.getEntriesByType('resource');
      const bytes = (nav.transferSize || 0) + res.reduce((a, r) => a + (r.transferSize || 0), 0);
      const ms = Math.round(nav.loadEventEnd || nav.domContentLoadedEventEnd || performance.now());
      const kb = Math.round(bytes / 1024);
      const $ = (s) => document.querySelector(s);
      if (ms > 0) {
        $('[data-ms]').textContent = ms < 1000 ? ms + ' ms' : (ms / 1000).toFixed(2) + ' s';
      }
      // A cached visit transfers almost nothing; say so instead of claiming a 2 KB website.
      if (kb >= 5) {
        $('[data-kb]').textContent = kb + ' KB';
        $('[data-kb-small]').textContent = kb + ' KB';
        const median = Number($('[data-median]').textContent) * 1024 || 2311;
        $('[data-bar-us]').style.setProperty('--w', Math.max(1.5, (kb / median) * 100).toFixed(1) + '%');
      } else if (nav.transferSize === 0) {
        $('[data-kb]').textContent = 'cached';
        $('[data-ms-label]').textContent = 'to load this page from your browser’s cache. Measured just now.';
      }
    } catch (e) { /* the fallback text is already true */ }
  }, 0));
</script>
